# Copy to .env. Everything is optional for local development.

# Postgres connection string (Neon, Vercel Postgres, Supabase, local Postgres).
# Leave unset to use PGlite: real Postgres compiled to WASM, running in-process.
# DATABASE_URL=postgres://user:password@localhost:5432/submitted

# Where PGlite keeps its files when DATABASE_URL is unset. Omit for in-memory
# (fresh, auto-seeded database on every restart).
PGLITE_DIR=.data/pglite

# Signs the session cookie. Required in production with a real database.
# Generate one with: node -e "console.log(crypto.randomUUID())"
SESSION_SECRET=change-me
